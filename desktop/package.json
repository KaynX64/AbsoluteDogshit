{
  "name": "valetudo-desktop",
  "private": true,
  "version": "1.0.1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.*",
    "test:smoke": "node tests/smoke/packaged.mjs",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "signature_pad": "^5.1.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.psu.valetudo.desktop",
    "productName": "Valetudo HealthLink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app-config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/valetudo_icon.ico",
      "extraResources": [
        {
          "from": "src/assets/valetudo_icon.ico",
          "to": "valetudo_icon.ico"
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ValetudoHealthLink-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:8080/"
      }
    ],
    "asar": true
  }
}
