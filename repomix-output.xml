              <b>Purpose:</b> ${clearancePurpose}<br/>
              <b>Valid Until:</b> <span style="color: #0f766e; font-weight: bold;">${new Date(clearanceExpiryDate).toLocaleDateString()}</span><br/>
              <b>Clinical Assessment / Remarks:</b> ${clearanceRemarks}
