                      </div>
                    </div>

                    {confirmCheckIn.allergies &&
                      confirmCheckIn.allergies !== 'None' &&
                      confirmCheckIn.allergies !== 'None reported' &&
                      confirmCheckIn.allergies !== 'None listed' && (
                        <div
                          style={{
                            marginTop: 12,
                            padding: '8px 12px',
                            background: C.dangerSoft,
                            borderRadius: 10,
