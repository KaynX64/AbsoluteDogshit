              let badgeColor = '#b45309';
              let badgeBg = '#fef3c7';

              if (app.status === 'serving') {
                badgeColor = '#0369a1';
                badgeBg = '#e0f2fe';
              } else if (app.status === 'completed') {
                badgeColor = '#15803d';
                badgeBg = '#dcfce7';
              } else if (app.status === 'cancelled' || app.status === 'no_show') {
