                      )}
                  </div>

                  <div
                    style={{
                      display: 'flex',
                      gap: 10,
                      justifyContent: 'flex-end',
                      paddingTop: 16,
                      borderTop: `1px solid ${C.border}`,
                    }}
                  >
                    <button
                      type="button"
                      onClick={() => setConfirmCheckIn(null)}
                      disabled={checkingInId !== null}
                      style={{
                        padding: '11px 22px',
                        borderRadius: 999,
                        background: C.sage100,
                        color: C.text,
                        border: 'none',
                        fontSize: 13,
                        fontWeight: 700,
