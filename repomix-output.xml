            >
              <p style={{ margin: 0, fontSize: 11.5, color: T.textMuted, fontStyle: 'italic' }}>
                Records are appended — existing entries are preserved.
              </p>
              <div style={{ display: 'flex', gap: 10 }}>
                <button
                  type="button"
