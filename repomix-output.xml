                    <textarea
                      rows={4}
                      value={clearanceRemarks}
                      onChange={(e) => setClearanceRemarks(e.target.value)}
                      style={{ ...inputStyle, resize: 'vertical' }}
                    />
                  </div>

                  {/* 4. Issue and Print Action Button */}
                  <button
                    type="button"
                    onClick={handlePrintClearance}
                    disabled={!selectedApp || isIssuingClearance}
                    style={{
