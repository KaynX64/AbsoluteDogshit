      const realQrToken = data.qrToken;
      const clearanceId = data.clearanceId;
      const qrImageUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(realQrToken)}`;

      const htmlContent = `
