                fg: '#6E5526',
              },
              {
                label: 'Diabetes / endocrine',
                value: data.highRiskGroups?.diabetes_count || 0,
                bg: '#E4DEF2',
                fg: '#4A3A80',
              },
            ].map((item) => (
              <div
                key={item.label}
                style={{
                  padding: '16px 18px',
                  borderRadius: 20,
                  background: item.bg,
                }}
