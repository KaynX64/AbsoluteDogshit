/* desktop/src/theme/tokens.css
   Extracted directly from the Figma export.
   Do not rename variables — the JS theme file references them by name. */

:root {
  /* ── Brand ─────────────────────────────────────────────────────── */
  --ink:            #0F1E17;
  --primary:        #1F4A34;   /* sidebar active, buttons */
  --primary-dark:   #153627;
  --primary-mid:    #2E5C43;
  --primary-soft:   #4A7A5E;
  --primary-tint:   #E2EBE1;   /* card backgrounds on login */

  /* ── Sage (surfaces) ───────────────────────────────────────────── */
  --sage-50:        #F7F9F6;   /* app background */
  --sage-100:       #EEF3EC;   /* hovered row */
  --sage-200:       #E2EBE1;   /* sage cards */
  --sage-300:       #C9D9C7;   /* dividers on sage */
  --sage-400:       #A3B3A1;   /* muted icons */

  /* ── Neutrals ──────────────────────────────────────────────────── */
  --surface:        #FFFFFF;
  --surface-muted:  #FBFCFA;
  --border:         #DCE4DA;
  --border-soft:    #E8EDE6;

  /* ── Text ──────────────────────────────────────────────────────── */
  --text:           #191C1A;
  --text-sub:       #5A635B;
  --text-muted:     #94A396;
  --text-faint:     #B7C0B5;

  /* ── Semantics ─────────────────────────────────────────────────── */
  --danger:         #7A2E26;
  --danger-soft:    #FDE8E8;
  --danger-border:  #F8B4B4;

  --warning:        #8C6826;
  --warning-soft:   #FEF3C7;
  --warning-border: #FDE68A;

  --info:           #0369A1;
  --info-soft:      #E0F2FE;
  --info-border:    #BAE6FD;

  --success:        #15803D;
  --success-soft:   #DCFCE7;
  --success-border: #BBF7D0;

  /* ── Radius ────────────────────────────────────────────────────── */
  --r-xs:   6px;
  --r-sm:   10px;
  --r-md:   14px;
  --r-lg:   18px;
  --r-xl:   22px;
  --r-2xl:  28px;
  --r-pill: 999px;

  /* ── Shadows ───────────────────────────────────────────────────── */
  --shadow-xs: 0 1px 2px rgba(15,30,23,0.04);
  --shadow-sm: 0 2px 6px rgba(15,30,23,0.05);
  --shadow-md: 0 6px 16px rgba(15,30,23,0.06);
  --shadow-lg: 0 12px 32px rgba(15,30,23,0.08);

  /* ── Typography ────────────────────────────────────────────────── */
  --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
}
