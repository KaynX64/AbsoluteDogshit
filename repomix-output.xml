services:
  # 1. MySQL 8.0 with Spatial Support
  mysql:
    image: mysql:8.0
    container_name: valetudo-mysql
    restart: unless-stopped
    ports:
      - "127.0.0.1:3307:3306" # S-06: bind to loopback only
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?set MYSQL_ROOT_PASSWORD in .env}
      MYSQL_DATABASE: valetudo_healthlink
    volumes:
      - mysql_data:/var/lib/mysql

  # 2. Redis Live Queue Cache
  redis:
    image: redis:7-alpine
    container_name: valetudo-redis  
    restart: unless-stopped
    command: ["redis-server", "--requirepass", "${REDIS_PASSWORD:?set REDIS_PASSWORD in .env}"] # S-06: require auth
    ports:
      - "127.0.0.1:6379:6379" # S-06: bind to loopback only
    volumes:
      - redis_data:/data

# 3. MinIO S3-Compatible Object Storage
  minio:
    image: cgr.dev/chainguard/minio:latest
    container_name: valetudo-minio
    restart: unless-stopped
    user: "0:0"   # <-- Fixes the "file access denied" error
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?set MINIO_ROOT_USER in .env}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?set MINIO_ROOT_PASSWORD in .env}
    volumes:
      - minio_data:/data
    command: server /data --console-address ":9001"

volumes:
  mysql_data:
  redis_data:
  minio_data:
