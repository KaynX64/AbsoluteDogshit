                >
                  {item.value}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Low stock & expiry sweeps */}
        <div className="my-card">
          <h4
            className="my-card-title"
            style={{ marginBottom: 16 }}
          >
            Critical pharmacy inventory
          </h4>

          {!data.lowStockMeds || data.lowStockMeds.length === 0 ? (
            <div
              style={{
                padding: '32px 20px',
                textAlign: 'center',
                color: '#264D36',
                fontSize: 13,
                fontWeight: 700,
                background: '#D7E8D2',
                borderRadius: 20,
              }}
