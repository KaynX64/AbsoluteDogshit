                onChange={(e) => setDiagnosis(e.target.value)}
                required
              />
            </div>

            <div style={{ marginBottom: 12 }}>
              <label style={{ fontSize: 13, fontWeight: 'bold', color: '#334155', display: 'block', marginBottom: 4 }}>
                Treatment Plan & Rx:
