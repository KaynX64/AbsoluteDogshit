                  border: '1px solid #0f766e',
                  background: docType === 'rx' ? '#0f766e' : '#fff',
                  color: docType === 'rx' ? '#fff' : '#0f766e',
                }}
              >
                ℞ Prescription
              </button>
              <button
                type="button"
                onClick={() => setDocType('clearance')}
                style={{
                  padding: '4px 10px',
                  borderRadius: 4,
                  fontSize: 12,
                  fontWeight: 'bold',
                  cursor: 'pointer',
                  border: '1px solid #0f766e',
                  background: docType === 'clearance' ? '#0f766e' : '#fff',
