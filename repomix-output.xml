                padding: '6px 14px',
                borderRadius: 4,
                fontSize: 12,
                fontWeight: 'bold',
                cursor: 'pointer',
                border: '1px solid #0f766e',
                background: viewMode === 'analytics' ? '#0f766e' : '#ffffff',
                color: viewMode === 'analytics' ? '#ffffff' : '#0f766e',
              }}
