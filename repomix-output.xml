// server/src/routes/analytics.js
import express from 'express';
import { pool } from '../db.js';
import { verifyToken, requireRole } from '../middleware/rbac.js';

const router = express.Router();

// GET /api/analytics/summary - Retrieve aggregated health metrics
router.get('/summary', verifyToken, requireRole(['ADMIN', 'DOCTOR', 'NURSE']), async (req, res) => {
  try {
    // 1. Total consultations & breakdown by status
    const [consultationStats] = await db.query(`
      SELECT status, COUNT(*) as count 
      FROM appointments 
      GROUP BY status
    `);

    // 2. Top 5 medical diagnoses
    const [topDiagnoses] = await pool.query(`
      SELECT diagnosis, COUNT(*) as count 
      FROM emr_records 
      WHERE diagnosis IS NOT NULL AND diagnosis != '' 
      GROUP BY diagnosis 
      ORDER BY count DESC 
      LIMIT 5
    `);

    // 3. Emergency SOS alert distribution
    const [emergencyStats] = await pool.query(`
      SELECT status, COUNT(*) as count 
      FROM emergency_alerts 
      GROUP BY status
    `);

    // 4. Low stock inventory warnings
    const [lowStockMeds] = await pool.query(`
      SELECT name, category, stock_quantity 
      FROM inventory 
      WHERE stock_quantity < 20 
      ORDER BY stock_quantity ASC
    `);

    res.json({
      consultations: consultationStats,
      topDiagnoses,
      emergencies: emergencyStats,
      lowStockMeds
    });
  } catch (err) {
    console.error('Analytics aggregation error:', err);
    res.status(500).json({ error: 'Failed to aggregate health analytics data.' });
  }
});

// GET /api/analytics/export/csv - Stream medical consultation report as CSV
router.get('/export/csv', verifyToken, checkRole(['ADMIN', 'DOCTOR']), async (req, res) => {
  try {
    const [rows] = await pool.query(`
      SELECT 
        e.emr_id,
        u.first_name,
        u.last_name,
        u.student_no,
        e.chief_complaint,
        e.diagnosis,
        e.treatment_plan,
        e.created_at
      FROM emr_records e
      JOIN users u ON e.patient_id = u.user_id
      ORDER BY e.created_at DESC
    `);

    let csvContent = 'EMR ID,Student No,Patient Name,Chief Complaint,Diagnosis,Treatment Plan,Date\n';
    rows.forEach(r => {
      const name = `"${r.first_name} ${r.last_name}"`;
      const complaint = `"${(r.chief_complaint || '').replace(/"/g, '""')}"`;
      const diag = `"${(r.diagnosis || '').replace(/"/g, '""')}"`;
      const plan = `"${(r.treatment_plan || '').replace(/"/g, '""')}"`;
      csvContent += `${r.emr_id},${r.student_no || 'N/A'},${name},${complaint},${diag},${plan},${r.created_at}\n`;
    });

    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', `attachment; filename=health_report_${Date.now()}.csv`);
    res.status(200).send(csvContent);
  } catch (err) {
    res.status(500).json({ error: 'CSV export generation failed.' });
  }
});

export default router;
