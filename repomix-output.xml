                  >
                    <div
                      style={{
                        fontSize: 15,
                        fontWeight: 800,
                        color: C.text,
                        marginBottom: 10,
                      }}
                    >
                      {confirmCheckIn.first_name} {confirmCheckIn.last_name}
                    </div>

                    <div
                      style={{
                        display: 'grid',
                        gridTemplateColumns: '1fr 1fr',
                        gap: 10,
                        fontSize: 12.5,
                        color: C.textSub,
                      }}
