       FROM EMR_ATTACHMENTS a
       JOIN EMR_RECORDS e ON a.emr_id = e.emr_id
       JOIN USERS doc ON e.doctor_user_id = doc.user_id
       LEFT JOIN STAFF_PROFILES sp ON doc.user_id = sp.user_id
