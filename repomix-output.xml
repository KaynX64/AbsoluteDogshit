            </button>
            <button
              onClick={() => handleSwitchView('history')}
              style={{
                padding: '6px 14px',
                borderRadius: 4,
                fontSize: 12,
                fontWeight: 'bold',
                cursor: 'pointer',
                border: '1px solid #0284c7',
                background: viewMode === 'history' ? '#0284c7' : '#ffffff',
                color: viewMode === 'history' ? '#ffffff' : '#0284c7',
