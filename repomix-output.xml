              <div style={{ fontSize: 12, color: C.textSub, marginTop: 3 }}>
                {verifiedPatient.student_no || 'Staff'} · {verifiedPatient.course}
              </div>
            </div>
            {lastVerifiedAt && (
              <span
                style={{
                  padding: '4px 12px',
                  borderRadius: 999,
                  background: C.sage200,
