            </section>
          </div>
        </>
      )}

      {/* 4. MODAL: EMR HISTORY */}
      {showHistoryModal && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(0,0,0,0.5)',
