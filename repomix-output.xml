      {/* 3. MAIN WORKSPACE: EMR (LEFT) + ISSUANCE (RIGHT)              */}
      {/* ------------------------------------------------------------- */}
      <div style={{ display: 'grid', gridTemplateColumns: '1.15fr 1fr', gap: 20 }}>
