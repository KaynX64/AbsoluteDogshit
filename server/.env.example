PORT=5000

# ── Security & Cryptography (S-04, S-05) ─────────────────────────
ENCRYPTION_KEY=
JWT_SECRET=
ENCRYPTION_SALT=

# ── Database (MySQL) (B-02, S-29) ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=valetudo_app
DB_PASSWORD=
DB_NAME=valetudo_healthlink
MYSQL_ROOT_PASSWORD=

# ── Redis Cache (S-06, S-28) ─────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO / S3 Storage (S-06) ────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=valetudo-attachments

# ── Mailer (S-06) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Public URL used inside generated PDFs & QR codes ─────────────
PUBLIC_API_BASE_URL=https://192.168.18.116:5000

# ── Rate Limits & Grace Periods (all optional — defaults shown) ──
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=60

SOS_RATE_LIMIT_MAX=10
SOS_RATE_LIMIT_WINDOW=60

BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW=60

VERIFY_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_WINDOW=60

# How long past their appointment time a patient has before the auto
# worker flips them to 'no_show'. Default 20 minutes.
NOSHOW_GRACE_MINUTES=20