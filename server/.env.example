PORT=5000

# ── Security & Cryptography (S-04, S-05) ─────────────────────────
ENCRYPTION_KEY=
JWT_SECRET=
ENCRYPTION_SALT=

# Dedicated HMAC key for Dynamic QR Health Pass signing (SEC-08). Must
# differ from JWT_SECRET — generate one with: openssl rand -hex 32
# If left empty, a domain-separated key is derived from JWT_SECRET.
HEALTH_PASS_HMAC_SECRET=

# ── Database (MySQL) (B-02, S-29) ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=valetudo_app
DB_PASSWORD=
DB_NAME=valetudo_healthlink
MYSQL_ROOT_PASSWORD=

# ── Redis Cache (S-06, S-28) ─────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO / S3 Storage (S-06) ────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=valetudo-attachments

# ── Mailer (S-06) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Public URL used inside generated PDFs & QR codes ─────────────
PUBLIC_API_BASE_URL=https://192.168.18.116:5000

# ── CORS & Reverse Proxy (SEC-10) ─────────────────────────────────
# Comma-separated allow-list of browser origins that may call the API
# and open WebSocket connections. Defaults keep the Electron desktop
# console working (dev server + packaged file:// build, which reports
# the opaque origin "null"). Add your campus web portal here, e.g.:
# CORS_ALLOWED_ORIGINS=https://healthlink.psu.edu.ph,https://127.0.0.1:5173,null
CORS_ALLOWED_ORIGINS=

# Set to true ONLY when the API runs behind a reverse proxy (Nginx,
# HAProxy, cloud load balancer) so req.ip / per-IP rate limiting honor
# X-Forwarded-For. Leave empty or false for direct exposure.
TRUST_PROXY=false

# ── Rate Limits & Grace Periods (all optional — defaults shown) ──
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=60

SOS_RATE_LIMIT_MAX=10
SOS_RATE_LIMIT_WINDOW=60

BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW=60

VERIFY_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_WINDOW=60

# How long past their appointment time a patient has before the auto
# worker flips them to 'no_show'. Default 20 minutes.
NOSHOW_GRACE_MINUTES=20